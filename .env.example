ANTHROPIC_API_KEY=your_anthropic_api_key_here
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here
# Female voice (change to any Fish Audio model ID)
FISH_AUDIO_VOICE_ID=933563129e564b19a115bedd57b7406a

# Optional: restrict access — users must append ?token=<value> to the URL
# Leave blank to disable auth (open access)
FYRA_ACCESS_TOKEN=your_secret_token_here

# Optional: daily API spend cap in USD (default: 5.00)
DAILY_SPEND_CAP=5.00

# Google Calendar OAuth (Phase 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.railway.app/auth/google/callback

